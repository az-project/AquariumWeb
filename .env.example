APP_USERNAME=admin
APP_PASSWORD=aquarium
SESSION_SECRET=replace-with-at-least-32-characters

# file | supabase. If omitted, Supabase is used only when the URL and service key are present.
STORAGE_DRIVER=file

# Required when STORAGE_DRIVER=supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STATE_KEY=default

# Optional. Recommended for production remote MCP OAuth discovery.
REEFLOG_OAUTH_ISSUER=https://aqua.avokado.co.kr
REEFLOG_MCP_ALLOW_ORIGIN=*

# Optional. iOS 단축어(시리) 수질 기록용 고정 토큰. `openssl rand -hex 32` 등으로 생성.
REEFLOG_SHORTCUT_TOKEN=
REEFLOG_TIMEZONE=Asia/Seoul
